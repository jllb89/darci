**

!apps/
!apps/web/
!apps/web/**

apps/web/node_modules/
apps/web/.next/
apps/web/out/
apps/web/.turbo/
apps/web/coverage/
apps/web/.env
apps/web/.env.*

.git/
.DS_Store
