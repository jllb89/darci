PORT=4000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET_DOCUMENTS=documents
SUPABASE_STORAGE_BUCKET_SIGNATURES=signatures
SUPABASE_STORAGE_BUCKET_NOTARIZED=notarized-copies
DATABASE_URL=
REDIS_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# disabled | observe | enforced
BILLING_ENFORCEMENT_MODE=disabled
# Keep false until the approved iOS purchase path and storefront policy are recorded.
IOS_MEMBER_CHECKOUT_ENABLED=false
# Phase 7 worker controls.
BILLING_RECONCILIATION_RUNNER_ENABLED=true
BILLING_RECONCILIATION_INTERVAL_SECONDS=900
STRIPE_WEBHOOK_RETENTION_RUNNER_ENABLED=true
STRIPE_WEBHOOK_RETENTION_INTERVAL_SECONDS=86400
STRIPE_WEBHOOK_RETENTION_RUN_LIMIT=100
# Set only after the team records a completed staging lifecycle acceptance run.
BILLING_LIFECYCLE_ACCEPTANCE_ID=
POSTMARK_SERVER_TOKEN=
LEDGER_ANCHOR_URL=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Email delivery provider: "internal" (default, no external calls) | "resend"
NOTIFICATION_PROVIDER=internal
# Required when NOTIFICATION_PROVIDER=resend
RESEND_API_KEY=
# Required to verify POST /webhooks/resend signatures
RESEND_WEBHOOK_SECRET=
# Supabase Auth Send SMS Hook. Set the secret generated in Supabase Auth Hooks,
# then enable only when the hook URL is configured and AWS Pinpoint SMS Voice v2 can send SMS.
SUPABASE_AUTH_SMS_HOOK_ENABLED=false
SUPABASE_AUTH_SMS_HOOK_SECRET=
SUPABASE_AUTH_SMS_MESSAGE_TEMPLATE=Your DARCi verification code is {{otp}}.
SUPABASE_AUTH_SMS_ORIGINATION_IDENTITY=+18773624121
SUPABASE_AUTH_SMS_MESSAGE_TYPE=TRANSACTIONAL
PINPOINT_SMS_REGION=us-east-1
PINPOINT_SMS_ORIGINATION_IDENTITY=+18773624121
# SMS delivery provider: "internal" (default, no external calls) | "sns"
NOTIFICATION_SMS_PROVIDER=internal
# Extra safety gate for AWS SNS SMS delivery; set true only when ready to send paid SMS.
NOTIFICATION_PROVIDER_SNS_ENABLED=false
# Required when NOTIFICATION_SMS_PROVIDER=sns
SNS_REGION=
# Optional AWS SNS SMS sender id and type; type defaults to Transactional.
SNS_SMS_SENDER_ID=
SNS_SMS_TYPE=Transactional
# APNs push delivery for iOS. Keep disabled until device-token storage and APNs
# delivery are implemented; APNS_PRIVATE_KEY must be injected from a secret store.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.illuminote.darci
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
NOTIFICATION_PROVIDER_APNS_ENABLED=false
NOTIFICATION_APNS_ALLOWED_ENVS=sandbox
NOTIFICATION_APNS_ROLLOUT_PERCENT=0
# Comma-separated list of additional allowed CORS origins (for staging/production)
# e.g. https://app.staging.darciregistry.dev,https://app.darciregistry.dev
CORS_ALLOWED_ORIGINS=
