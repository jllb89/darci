# Docker build context hygiene for repo-root builds

# VCS and editor metadata
.git
.gitignore
.vscode
.idea
.DS_Store
Thumbs.db

# Never send local secrets into Docker builds
.env
.env.*
*.env

# Dependencies and generated output
node_modules
**/node_modules
backend/dist
apps/web/.next
apps/web/out
coverage
**/coverage

# Local/dev artifacts
*.log
*.tgz
*.swp
*.swo
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Workspace areas not needed by API/worker/web Docker builds
docs/*
mobile
linear
supabase
scripts
notes.md
commands.txt
progress-tests.md
ROADMAP.md
ISSUES.md
client-summary-trust-idn-schemas.md
trust & idn roadmap.md

# Runtime template sources required by backend PDF rendering.
!docs/CA DDPOA.md
!docs/OH DDPOA 1.0.docx.md
!docs/OH*DDPOA*.md
!docs/CA - DARCi Trust Registration Amendment (APE 260305) (1).md
!docs/CA - DARCi Trust Certification (APE 260305).md
!docs/OH - DARCi Trust Registration Amendment .md
!docs/OH - DARCi Trust Certification .md
